# ============================================================================
# Real Estate AI Decision Intelligence Platform -- Environment Variables
# ============================================================================
# Copy this file to `.env` in the same folder, then fill in real values.
# NEVER commit the actual `.env` file (it will contain real secrets) --
# only this `.env.example` template should ever be committed/shared.
#
#     cp .env.example .env
#     # then edit .env with your real DB password and Gemini API key
#
# Every script in this project reads these via os.environ (loaded
# automatically at startup through python-dotenv -- see db/connection.py
# and src/explanation/ai_explanation_layer.py). No credential is ever
# hardcoded anywhere in the codebase.
# ============================================================================


# ----------------------------------------------------------------------------
# PostgreSQL Database (Phase 1's real_estate_db)
# Used by: db/connection.py, and every module that supports --source db
# (src/finance, src/risk, src/geo, src/evidence, src/agents)
# ----------------------------------------------------------------------------

# Hostname of your PostgreSQL server. "localhost" if running on the same
# machine, or a remote host/IP if the database is hosted elsewhere.
DB_HOST=localhost

# PostgreSQL port. 5432 is the Postgres default -- change only if your
# server listens on a non-standard port.
DB_PORT=5432

# Database name (created during Phase 1 setup).
DB_NAME=real_estate_db

# Database username. REQUIRED -- there is no default; the app will refuse
# to start the DB path without this.
DB_USER=your_postgres_username

# Database password. REQUIRED -- there is no default. Never share this
# value or commit it to version control.
DB_PASSWORD=your_postgres_password


# ----------------------------------------------------------------------------
# Google Gemini API (Phase 10B's AI Explanation Layer)
# Used by: src/explanation/ai_explanation_layer.py
# ----------------------------------------------------------------------------

# Your Gemini API key, from https://aistudio.google.com/apikey
# REQUIRED for the live LLM explanation path. If this is left empty or
# unset, ai_explanation_layer.py automatically falls back to Phase 9's
# deterministic template explanation -- it never guesses or fails silently.
GEMINI_API_KEY=

# Which Gemini model to call. Kept configurable (rather than hardcoded)
# because Google's model lineup changes on its own schedule -- check
# https://ai.google.dev/gemini-api/docs/models for the current list
# before relying on this default in production.
GEMINI_MODEL=gemini-2.5-flash
